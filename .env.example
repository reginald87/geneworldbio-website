ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
PORT=8787
# Public origin used for robots.txt and the XML sitemap. Set this to the live domain before launch.
# SITE_URL=https://www.example.com
# Optional: cookieless analytics endpoint. When unset, no analytics network requests are made.
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com/collect
# Optional: choose a persistent database path. Default is data/geneworldbio.sqlite.
# DB_PATH=data/geneworldbio.sqlite
# Enquiry emails. Two ways to send them.
# Option A - Resend (recommended for deliverability; requires a verified sending domain).
# When RESEND_API_KEY and ENQUIRY_NOTIFY_TO are both set, each enquiry sends an owner
# notification plus an acknowledgement to the enquirer.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# ENQUIRY_NOTIFY_TO=inbox@example.com
# ENQUIRY_FROM=GeneWorldBio Website <onboarding@resend.dev>
# Option B - SMTP (no Resend account needed; uses an existing mailbox).
# Used only when Resend is not configured. ENQUIRY_NOTIFY_TO is still required.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=website@example.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false
# PRIVACY_NOTICE_VERSION=v1.0
# Optional: WhatsApp Business number. Adds a click-to-chat link on the contact form.
# VITE_WHATSAPP_NUMBER=+2348012345678
# Optional: Cloudflare Turnstile bot check for the public contact form.
# The site key is public and must be prefixed VITE_ for the client; keep the secret key server-side.
# When both are unset, the form works without the check.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAexampleSiteKey
# TURNSTILE_SECRET_KEY=0x4AAAAAAAexampleSecretKey
# Optional: allow submissions through when Cloudflare is unreachable (logged, not silent).
# Off by default, which means an unreachable bot check rejects the submission.
# TURNSTILE_FAIL_OPEN=false
# Optional: enquiries allowed per device per 10 minutes. Default is 5.
# ENQUIRY_RATE_LIMIT=5
# Optional: database backup settings used by `npm run backup`.
# BACKUP_DIR=data/backups
# BACKUP_KEEP=30
